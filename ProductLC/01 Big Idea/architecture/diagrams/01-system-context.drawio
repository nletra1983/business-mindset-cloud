        <mxCell id="sub" value="C4, уровень 1. Одно ядро, два входа в MVP: Telegram и мобильное приложение. Веб, Макс и оплата — позже." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=13;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="24" y="48" width="1550" height="22" as="geometry"/></mxCell>
        <mxCell id="trust" value="Наш контур" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#B00020;dashed=1;dashPattern=8 4;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontColor=#B00020;fontFamily=Arial;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="430" y="110" width="480" height="840" as="geometry"/></mxCell>
        <mxCell id="sys" value="&lt;b&gt;Business Mindset&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 11px&quot;&gt;[Software System]&lt;/font&gt;&lt;br&gt;Ведёт разбор новости и хранит аккаунт" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1168BD;strokeColor=#0E5091;fontColor=#ffffff;arcSize=8;fontFamily=Arial;fontSize=14;verticalAlign=middle;align=center;spacing=8;" vertex="1" parent="1"><mxGeometry x="500" y="380" width="340" height="250" as="geometry"/></mxCell>
        <mxCell id="p_user" value="&lt;b&gt;Предприниматель&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 11px&quot;&gt;[Person]&lt;/font&gt;&lt;br&gt;Проходит разбор и входит в аккаунт" style="shape=mxgraph.c4.person2;html=1;whiteSpace=wrap;fillColor=#08427B;strokeColor=#072F57;fontColor=#ffffff;align=center;verticalAlign=bottom;fontFamily=Arial;fontSize=13;spacingBottom=2;resizable=1;" vertex="1" parent="1"><mxGeometry x="40" y="170" width="200" height="190" as="geometry"/></mxCell>
        <mxCell id="p_author" value="&lt;b&gt;Автор скиллов&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 11px&quot;&gt;[Person]&lt;/font&gt;&lt;br&gt;Публикует скилл и правила оценки" style="shape=mxgraph.c4.person2;html=1;whiteSpace=wrap;fillColor=#08427B;strokeColor=#072F57;fontColor=#ffffff;align=center;verticalAlign=bottom;fontFamily=Arial;fontSize=13;spacingBottom=2;resizable=1;" vertex="1" parent="1"><mxGeometry x="40" y="430" width="200" height="190" as="geometry"/></mxCell>
        <mxCell id="p_coach" value="&lt;b&gt;Наставник группы&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 11px&quot;&gt;[Person]&lt;/font&gt;&lt;br&gt;Позже. Читает сводку группы" style="shape=mxgraph.c4.person2;html=1;whiteSpace=wrap;fillColor=#08427B;strokeColor=#072F57;fontColor=#ffffff;align=center;verticalAlign=bottom;fontFamily=Arial;fontSize=13;spacingBottom=2;resizable=1;" vertex="1" parent="1"><mxGeometry x="40" y="700" width="200" height="190" as="geometry"/></mxCell>
        <mxCell id="tg" value="&lt;b&gt;Telegram&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 11px&quot;&gt;[Software System]&lt;/font&gt;&lt;br&gt;Первый канал. Вход и разбор" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#999999;strokeColor=#6B6B6B;fontColor=#ffffff;arcSize=8;fontFamily=Arial;fontSize=13;verticalAlign=middle;align=center;spacing=6;" vertex="1" parent="1"><mxGeometry x="1060" y="140" width="540" height="90" as="geometry"/></mxCell>
        <mxCell id="models" value="&lt;b&gt;Провайдеры моделей&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 11px&quot;&gt;[Software System]&lt;/font&gt;&lt;br&gt;Отвечают выбранной бесплатной моделью" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#999999;strokeColor=#6B6B6B;fontColor=#ffffff;arcSize=8;fontFamily=Arial;fontSize=13;verticalAlign=middle;align=center;spacing=6;" vertex="1" parent="1"><mxGeometry x="1060" y="270" width="540" height="100" as="geometry"/></mxCell>
        <mxCell id="news" value="&lt;b&gt;Новостные сайты&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 11px&quot;&gt;[Software System]&lt;/font&gt;&lt;br&gt;Позже. Страница по ссылке и рубрики скилла" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#999999;strokeColor=#6B6B6B;fontColor=#ffffff;arcSize=8;fontFamily=Arial;fontSize=13;verticalAlign=middle;align=center;spacing=6;" vertex="1" parent="1"><mxGeometry x="1060" y="410" width="540" height="100" as="geometry"/></mxCell>
