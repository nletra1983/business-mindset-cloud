<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="app.diagrams.net" type="device">
  <diagram id="deployment" name="03 Размещение">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1169" math="0" shadow="0" background="#ffffff">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" value="Business Mindset — размещение" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=20;fontColor=#0E5091;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="24" y="16" width="1200" height="32" as="geometry"/></mxCell>
        <mxCell id="sub" value="Данные в российском регионе. Телефон не вызывает провайдера модели. Исходящий шлюз — только для модели, до которой регион не достучится." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=13;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="24" y="48" width="1580" height="22" as="geometry"/></mxCell>
        <mxCell id="rf" value="Российский регион · одна зона · здесь лежат данные" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#B00020;dashed=1;dashPattern=8 4;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontColor=#B00020;fontFamily=Arial;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="300" y="120" width="700" height="640" as="geometry"/></mxCell>
        <mxCell id="egress" value="Исходящий контур · позже · диалоги не хранятся" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#B00020;dashed=1;dashPattern=8 4;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontColor=#B00020;fontFamily=Arial;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1080" y="120" width="530" height="250" as="geometry"/></mxCell>
        <mxCell id="user" value="&lt;b&gt;Предприниматель&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 11px&quot;&gt;[Person]&lt;/font&gt;&lt;br&gt;Телефон с VPN и без него" style="shape=mxgraph.c4.person2;html=1;whiteSpace=wrap;fillColor=#08427B;strokeColor=#072F57;fontColor=#ffffff;align=center;verticalAlign=bottom;fontFamily=Arial;fontSize=13;spacingBottom=2;resizable=1;" vertex="1" parent="1"><mxGeometry x="40" y="280" width="200" height="200" as="geometry"/></mxCell>
        <mxCell id="app" value="&lt;b&gt;Приложение&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 11px&quot;&gt;[Container: сервис]&lt;/font&gt;&lt;br&gt;Единственный вход для телефона" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1168BD;strokeColor=#0E5091;fontColor=#ffffff;arcSize=8;fontFamily=Arial;fontSize=14;verticalAlign=middle;align=center;spacing=8;" vertex="1" parent="1"><mxGeometry x="360" y="200" width="300" height="150" as="geometry"/></mxCell>
        <mxCell id="db" value="&lt;b&gt;База&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 11px&quot;&gt;[Container: хранилище]&lt;/font&gt;&lt;br&gt;Аккаунты, ходы, след" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=14;fillColor=#438DD5;strokeColor=#2E6295;fontColor=#ffffff;fontFamily=Arial;fontSize=13;spacing=4;" vertex="1" parent="1"><mxGeometry x="360" y="420" width="250" height="140" as="geometry"/></mxCell>
        <mxCell id="secrets" value="&lt;b&gt;Секреты&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 11px&quot;&gt;[Container: хранилище]&lt;/font&gt;&lt;br&gt;Ключи сервиса" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=14;fillColor=#438DD5;strokeColor=#2E6295;fontColor=#ffffff;fontFamily=Arial;fontSize=13;spacing=4;" vertex="1" parent="1"><mxGeometry x="660" y="420" width="250" height="140" as="geometry"/></mxCell>
        <mxCell id="relay" value="&lt;b&gt;Исходящий шлюз&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 11px&quot;&gt;[Container: шлюз]&lt;/font&gt;&lt;br&gt;Позже. Передаёт запрос и не пишет диалог" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1168BD;strokeColor=#0E5091;fontColor=#ffffff;arcSize=8;fontFamily=Arial;fontSize=14;verticalAlign=middle;align=center;spacing=8;" vertex="1" parent="1"><mxGeometry x="1160" y="180" width="360" height="130" as="geometry"/></mxCell>
        <mxCell id="rfm" value="&lt;b&gt;Провайдеры моделей из РФ&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 11px&quot;&gt;[Software System]&lt;/font&gt;&lt;br&gt;Бесплатные модели MVP. Вызов из региона" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#999999;strokeColor=#6B6B6B;fontColor=#ffffff;arcSize=8;fontFamily=Arial;fontSize=13;verticalAlign=middle;align=center;spacing=6;" vertex="1" parent="1"><mxGeometry x="340" y="800" width="620" height="110" as="geometry"/></mxCell>
        <mxCell id="foreign" value="&lt;b&gt;Зарубежные провайдеры моделей&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 11px&quot;&gt;[Software System]&lt;/font&gt;&lt;br&gt;Позже. Только через исходящий шлюз" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#999999;strokeColor=#6B6B6B;fontColor=#ffffff;arcSize=8;fontFamily=Arial;fontSize=13;verticalAlign=middle;align=center;spacing=6;" vertex="1" parent="1"><mxGeometry x="1160" y="430" width="400" height="110" as="geometry"/></mxCell>
        <mxCell id="tg" value="&lt;b&gt;Telegram&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 11px&quot;&gt;[Software System]&lt;/font&gt;&lt;br&gt;Бот. Телефон к API Telegram не ходит за моделью" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#999999;strokeColor=#6B6B6B;fontColor=#ffffff;arcSize=8;fontFamily=Arial;fontSize=13;verticalAlign=middle;align=center;spacing=6;" vertex="1" parent="1"><mxGeometry x="1160" y="600" width="400" height="110" as="geometry"/></mxCell>
        <mxCell id="note" value="Непроизводственная среда повторяет этот контур и меньше его. Если API Telegram из региона не откроется, тонкий исходящий путь получает только модуль каналов." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FAFAFA;strokeColor=#D0D0D0;fontColor=#333333;fontFamily=Arial;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="360" y="640" width="560" height="70" as="geometry"/></mxCell>
        <mxCell id="e_in" value="HTTPS, с VPN и без него" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=blockThin;endFill=1;strokeColor=#4A4A4A;fontColor=#222222;fontFamily=Arial;fontSize=11;labelBackgroundColor=#FFFFFF;endSize=8;" edge="1" parent="1" source="user" target="app"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e_db" value="аккаунт, ход и след" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=blockThin;endFill=1;strokeColor=#4A4A4A;fontColor=#222222;fontFamily=Arial;fontSize=11;labelBackgroundColor=#FFFFFF;endSize=8;" edge="1" parent="1" source="app" target="db"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e_sec" value="ключ в момент вызова" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=blockThin;endFill=1;strokeColor=#4A4A4A;fontColor=#222222;fontFamily=Arial;fontSize=11;labelBackgroundColor=#FFFFFF;endSize=8;" edge="1" parent="1" source="app" target="secrets"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e_rf" value="модель, досягаемая из региона" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=blockThin;endFill=1;strokeColor=#4A4A4A;fontColor=#222222;fontFamily=Arial;fontSize=11;labelBackgroundColor=#FFFFFF;endSize=8;" edge="1" parent="1" source="app" target="rfm"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e_rel" value="позже: модель вне досягаемости региона" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=blockThin;endFill=1;strokeColor=#4A4A4A;fontColor=#222222;fontFamily=Arial;fontSize=11;labelBackgroundColor=#FFFFFF;endSize=8;" edge="1" parent="1" source="app" target="relay"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e_for" value="запрос без записи диалога" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=blockThin;endFill=1;strokeColor=#4A4A4A;fontColor=#222222;fontFamily=Arial;fontSize=11;labelBackgroundColor=#FFFFFF;endSize=8;" edge="1" parent="1" source="relay" target="foreign"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e_tg" value="бот" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=blockThin;endFill=1;strokeColor=#4A4A4A;fontColor=#222222;fontFamily=Arial;fontSize=11;labelBackgroundColor=#FFFFFF;endSize=8;" edge="1" parent="1" source="app" target="tg"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="stamp" value="&lt;b&gt;Штамп.&lt;/b&gt; Business Mindset · размещение · черновик · 2026-10-28 · горизонт: MVP и швы роста" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=13;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="24" y="972" width="1550" height="22" as="geometry"/></mxCell>
        <mxCell id="legend" value="&lt;b&gt;Легенда&lt;/b&gt;&lt;br&gt;
&lt;span style=&quot;background:#08427B;color:#ffffff;&quot;&gt;&amp;nbsp;человек&amp;nbsp;&lt;/span&gt;&amp;nbsp;
&lt;span style=&quot;background:#1168BD;color:#ffffff;&quot;&gt;&amp;nbsp;наша система / контейнер&amp;nbsp;&lt;/span&gt;&amp;nbsp;
&lt;span style=&quot;background:#F4F8FC;color:#1A1A1A;border:1px solid #0E5091;&quot;&gt;&amp;nbsp;модуль&amp;nbsp;&lt;/span&gt;&amp;nbsp;
&lt;span style=&quot;background:#438DD5;color:#ffffff;&quot;&gt;&amp;nbsp;хранилище&amp;nbsp;&lt;/span&gt;&amp;nbsp;
&lt;span style=&quot;background:#999999;color:#ffffff;&quot;&gt;&amp;nbsp;внешняя система&amp;nbsp;&lt;/span&gt;&lt;br&gt;
&lt;span style=&quot;color:#B00020;&quot;&gt;— — рамка доверия&lt;/span&gt;&amp;nbsp;&amp;nbsp;
&lt;span style=&quot;color:#666666;&quot;&gt;- - граница системы&lt;/span&gt;&amp;nbsp;&amp;nbsp;
сплошная стрелка — синхронный вызов&amp;nbsp;&amp;nbsp;
пунктирная стрелка — асинхронно, на этих листах таких связей нет&lt;br&gt;
Пометка «позже» — шов архитектуры, в текущий MVP не входит." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FAFAFA;strokeColor=#D0D0D0;fontColor=#333333;fontFamily=Arial;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="24" y="1008" width="1606" height="140" as="geometry"/></mxCell>
      </root>
