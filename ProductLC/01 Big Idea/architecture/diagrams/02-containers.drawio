        <mxCell id="e_gp" value="позже проверяет платное право" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=blockThin;endFill=1;strokeColor=#4A4A4A;fontColor=#222222;fontFamily=Arial;fontSize=11;labelBackgroundColor=#FFFFFF;endSize=8;" edge="1" parent="1" source="account" target="pay"><mxGeometry relative="1" as="geometry"/></mxCell>
