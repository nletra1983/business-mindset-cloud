        <mxCell id="sub" value="C4, уровень 2. Один процесс. Аккаунт и разбор новости — модули, не отдельные сервисы." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=13;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="24" y="42" width="1550" height="20" as="geometry"/></mxCell>
