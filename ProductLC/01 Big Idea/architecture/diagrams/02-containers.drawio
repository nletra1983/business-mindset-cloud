        <mxCell id="trust" value="Серверный контур" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#B00020;dashed=1;dashPattern=8 4;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontColor=#B00020;fontFamily=Arial;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="450" y="84" width="680" height="852" as="geometry"/></mxCell>
        <mxCell id="app" value="Приложение  [Container: сервис]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1168BD;strokeColor=#0E5091;fontColor=#ffffff;arcSize=3;verticalAlign=top;align=left;spacingLeft=12;spacingTop=8;fontFamily=Arial;fontSize=14;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="470" y="112" width="640" height="470" as="geometry"/></mxCell>
        <mxCell id="channels" value="&lt;b&gt;Каналы&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 11px&quot;&gt;[Модуль]&lt;/font&gt;&lt;br&gt;Telegram сейчас. Сюда же приложение. Макс позже" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F4F8FC;strokeColor=#0E5091;fontColor=#1A1A1A;arcSize=8;fontFamily=Arial;fontSize=12;verticalAlign=middle;align=center;spacing=6;" vertex="1" parent="1"><mxGeometry x="486" y="150" width="608" height="56" as="geometry"/></mxCell>
        <mxCell id="account" value="&lt;b&gt;Аккаунт&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 11px&quot;&gt;[Модуль]&lt;/font&gt;&lt;br&gt;Внутренний id, телефон, Telegram user id, слияние кодом" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F4F8FC;strokeColor=#0E5091;fontColor=#1A1A1A;arcSize=8;fontFamily=Arial;fontSize=12;verticalAlign=middle;align=center;spacing=6;" vertex="1" parent="1"><mxGeometry x="486" y="214" width="608" height="56" as="geometry"/></mxCell>
        <mxCell id="workout" value="&lt;b&gt;Ход упражнения&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 11px&quot;&gt;[Модуль]&lt;/font&gt;&lt;br&gt;Одна формулировка человека. Шаг, диалог, сводка" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F4F8FC;strokeColor=#0E5091;fontColor=#1A1A1A;arcSize=8;fontFamily=Arial;fontSize=12;verticalAlign=middle;align=center;spacing=6;" vertex="1" parent="1"><mxGeometry x="486" y="278" width="608" height="56" as="geometry"/></mxCell>
        <mxCell id="skills" value="&lt;b&gt;Скилл новости&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 11px&quot;&gt;[Модуль]&lt;/font&gt;&lt;br&gt;Вопросы и правила оценки. Версия хранится на ходе" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F4F8FC;strokeColor=#0E5091;fontColor=#1A1A1A;arcSize=8;fontFamily=Arial;fontSize=12;verticalAlign=middle;align=center;spacing=6;" vertex="1" parent="1"><mxGeometry x="486" y="342" width="608" height="56" as="geometry"/></mxCell>
        <mxCell id="gateway" value="&lt;b&gt;Шлюз моделей&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 11px&quot;&gt;[Модуль]&lt;/font&gt;&lt;br&gt;Только модели, которые открыл аккаунт. В MVP бесплатные" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F4F8FC;strokeColor=#0E5091;fontColor=#1A1A1A;arcSize=8;fontFamily=Arial;fontSize=12;verticalAlign=middle;align=center;spacing=6;" vertex="1" parent="1"><mxGeometry x="486" y="406" width="608" height="56" as="geometry"/></mxCell>
        <mxCell id="profile" value="&lt;b&gt;Профиль навыка&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 11px&quot;&gt;[Модуль]&lt;/font&gt;&lt;br&gt;Скрытый след. Человек видит только личные данные" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F4F8FC;strokeColor=#0E5091;fontColor=#1A1A1A;arcSize=8;fontFamily=Arial;fontSize=12;verticalAlign=middle;align=center;spacing=6;" vertex="1" parent="1"><mxGeometry x="486" y="470" width="608" height="56" as="geometry"/></mxCell>
        <mxCell id="db" value="&lt;b&gt;База&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 11px&quot;&gt;[Container: хранилище]&lt;/font&gt;&lt;br&gt;Аккаунты, ходы, диалоги, сводки, скрытый след" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=14;fillColor=#438DD5;strokeColor=#2E6295;fontColor=#ffffff;fontFamily=Arial;fontSize=13;spacing=4;" vertex="1" parent="1"><mxGeometry x="486" y="620" width="290" height="130" as="geometry"/></mxCell>
        <mxCell id="secrets" value="&lt;b&gt;Секреты&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 11px&quot;&gt;[Container: хранилище]&lt;/font&gt;&lt;br&gt;Ключи сервиса к бесплатным моделям" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=14;fillColor=#438DD5;strokeColor=#2E6295;fontColor=#ffffff;fontFamily=Arial;fontSize=13;spacing=4;" vertex="1" parent="1"><mxGeometry x="800" y="620" width="280" height="130" as="geometry"/></mxCell>
        <mxCell id="note" value="Ссылка на страницу и подборка сайтов — позже, отдельным модулем загрузки. Свой ключ человека к платной модели — тоже позже." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FAFAFA;strokeColor=#D0D0D0;fontColor=#333333;fontFamily=Arial;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="486" y="770" width="594" height="56" as="geometry"/></mxCell>
        <mxCell id="mobile" value="&lt;b&gt;Мобильное приложение&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 11px&quot;&gt;[Container: клиент]&lt;/font&gt;&lt;br&gt;Вход по телефону. Ходит только в каналы" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1168BD;strokeColor=#0E5091;fontColor=#ffffff;arcSize=8;fontFamily=Arial;fontSize=14;verticalAlign=middle;align=center;spacing=8;" vertex="1" parent="1"><mxGeometry x="266" y="180" width="170" height="130" as="geometry"/></mxCell>
        <mxCell id="web" value="&lt;b&gt;Веб&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 11px&quot;&gt;[Container: клиент]&lt;/font&gt;&lt;br&gt;Позже. Тот же аккаунт и те же ходы" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1168BD;strokeColor=#0E5091;fontColor=#ffffff;arcSize=8;fontFamily=Arial;fontSize=14;verticalAlign=middle;align=center;spacing=8;" vertex="1" parent="1"><mxGeometry x="266" y="340" width="170" height="110" as="geometry"/></mxCell>
        <mxCell id="tg" value="&lt;b&gt;Telegram&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 11px&quot;&gt;[Software System]&lt;/font&gt;&lt;br&gt;Первый канал" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#999999;strokeColor=#6B6B6B;fontColor=#ffffff;arcSize=8;fontFamily=Arial;fontSize=13;verticalAlign=middle;align=center;spacing=6;" vertex="1" parent="1"><mxGeometry x="16" y="180" width="220" height="100" as="geometry"/></mxCell>
        <mxCell id="max" value="&lt;b&gt;Макс&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 11px&quot;&gt;[Software System]&lt;/font&gt;&lt;br&gt;Позже. Тот же ход" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#999999;strokeColor=#6B6B6B;fontColor=#ffffff;arcSize=8;fontFamily=Arial;fontSize=13;verticalAlign=middle;align=center;spacing=6;" vertex="1" parent="1"><mxGeometry x="16" y="310" width="220" height="90" as="geometry"/></mxCell>
        <mxCell id="pay" value="&lt;b&gt;Оплата&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 11px&quot;&gt;[Software System]&lt;/font&gt;&lt;br&gt;Позже. Открывает платные модели" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#999999;strokeColor=#6B6B6B;fontColor=#ffffff;arcSize=8;fontFamily=Arial;fontSize=13;verticalAlign=middle;align=center;spacing=6;" vertex="1" parent="1"><mxGeometry x="16" y="640" width="220" height="110" as="geometry"/></mxCell>
        <mxCell id="models" value="&lt;b&gt;Провайдеры моделей&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 11px&quot;&gt;[Software System]&lt;/font&gt;&lt;br&gt;Вызов с сервера, не с телефона" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#999999;strokeColor=#6B6B6B;fontColor=#ffffff;arcSize=8;fontFamily=Arial;fontSize=13;verticalAlign=middle;align=center;spacing=6;" vertex="1" parent="1"><mxGeometry x="1180" y="390" width="440" height="90" as="geometry"/></mxCell>
